# Release signing for sideloadable APKs.
# Copy to keystore.properties (gitignored) and fill in to sign release builds with
# your own key. If this file is absent, `assembleRelease` falls back to the debug
# keystore so the APK is still installable.
#
# Generate a key:
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias aiostreamer
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=aiostreamer
keyPassword=CHANGE_ME
